{
  "name": "tenpuzzle",
  "private": true,
  "description": "テンパズル（単一HTML）。このパッケージは Firebase ルールのテスト用の開発依存だけを持つ（ゲーム本体は依存なし）",
  "scripts": {
    "test:rules": "firebase emulators:exec --only database --project demo-tenpuzzle \"node tests/test_tenpuzzle_rules_v12.js\"",
    "test:prepare": "node tests/test_tenpuzzle_prepare_rules_v12.js",
    "test:solo": "node tests/test_tenpuzzle_v12.js",
    "test:candidate": "firebase emulators:exec --only database --project demo-tenpuzzle \"node tests/test_tenpuzzle_candidate_v12.js\"",
    "test:lobby": "firebase emulators:exec --only auth,database --project demo-tp-lobby \"node tests/test_tenpuzzle_lobby_v12.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.35.1"
  },
  "engines": {
    "node": ">=18"
  }
}

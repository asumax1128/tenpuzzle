{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "iroyomi": {
        "rooms": {
          "$code": {
            ".read": "auth != null",
            "note": { ".write": "auth != null", ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      },
      "factor": {
        "scores": {
          ".read": true,
          "$uid": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
